# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# SQLite database file (relative to the backend directory).
DATABASE_PATH=data/zero_cool.db
TECHNOLOGIES_FILE=technologies.yaml

# Optional. Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD enrichment works but is about 10x slower.
NVD_API_KEY=
